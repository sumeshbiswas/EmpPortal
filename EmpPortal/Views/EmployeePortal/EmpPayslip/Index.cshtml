    @{
        ViewBag.Title = "Employee Portal Payslip";
        Layout = "~/Views/Shared/EmployeeLayout.cshtml";
    }
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8" />
    

        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
 
    </head>

    <body>
 
        <div class="emp-bar">
            <div class="emp-main-title">
            <i class="fa-solid fa-money-bill-wave"></i>
                <span>Employee Salary Slip</span>
            </div>
        </div>
    <fieldset class="emp_payslip-fieldset">

        <legend class="emp_payslip-legend">
            Payslip Filter
        </legend>

        <div class="emp_payslip-row">

            <!-- Left Side -->
            <div class="emp_payslip-inline-group">

                <label for="ddlMonth" class="emp_payslip-label-inline">
                    Select Month
                </label>

                <select id="ddlMonth" class="form-select emp_payslip-select">
                </select>

            </div>

            <!-- Right Side -->
            <div class="emp_payslip-action">
                <button class="emp_payslip-download-btn" id="btn_downloadslip">
                    <i class="fa-solid fa-download"></i>
                    Download
                </button>
            </div>

        </div>

    </fieldset>
    <div id="payslipContent">

        <img id="companyLogo" src="@Url.Content("~/images/complogo.jpeg")" style="display:none;" />

        <fieldset class="emp_payslipsubsection-fieldset">

            <legend class="emp_payslipsubsection-legend">
                Payslip Details
            </legend>

            <!-- Company & Month -->
            <div class="emp_payslipsubsection-row emp_payslipsubsection-border">

                <div class="emp_payslipsubsection-item">
                    <span class="emp_payslipsubsection-label">Company Name :</span>
                    <span id="companyName"></span>
                    <span id="Compddress" hidden></span>
                </div>

                <div class="emp_payslipsubsection-item">
                    <span class="emp_payslipsubsection-label">For the Month :</span>
                    <span id="salaryMonth"></span>
                </div>

            </div>


            <!-- Employee Info -->
            <div class="emp_payslipsubsection-row emp_payslipsubsection-border">

                <div class="emp_payslipsubsection-col">

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Name :</span>
                        <span id="empName"></span>
                    </div>

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Card No :</span>
                        <span id="cardNo"></span>
                    </div>

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Father/Husband :</span>
                        <span id="fatherName"></span>
                    </div>

                </div>


                <div class="emp_payslipsubsection-col">

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Department :</span>
                        <span id="department"></span>
                    </div>

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Designation :</span>
                        <span id="designation"></span>
                    </div>

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Date of Joining :</span>
                        <span id="joinDate"></span>
                    </div>

                </div>

            </div>


            <!-- PF / ESI -->
            <div class="emp_payslipsubsection-row">

                <div class="emp_payslipsubsection-col">

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">P.F. No :</span>
                        <span id="pfNo"></span>
                    </div>

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">E.S.I No :</span>
                        <span id="esiNo"></span>
                    </div>

                </div>


                <div class="emp_payslipsubsection-col">

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Working Days :</span>
                        <span id="workDay"></span>
                    </div>

                    <div class="emp_payslipsubsection-item">
                        <span class="emp_payslipsubsection-label">Leave Availed :</span>
                        <span id="leaveDay"></span>
                    </div>

                </div>

            </div>

        </fieldset>

    </div>
    <!-- Salary Table -->
    <div class="emp_paysliptable-wrapper">

        <table class="main emp_paysliptable">

            <thead>
                <tr class="emp-tablehead emp_paysliptable-head">
                    <th>Particulars</th>
                    <th class="col-right">Gross</th>
                    <th class="col-right">Earnings</th>
                    <th></th>
                    <th>Particulars</th>
                    <th class="col-right">Deductions</th>
                </tr>
            </thead>

            <tbody id="earningBody"></tbody>

            <tfoot>
                <tr class="emp_tabledownrow emp_paysliptable-footer">
                    <td class="totals">Total</td>
                    <td class="col-right totals" id="totalGross"></td>
                    <td class="col-right totals" id="totalEarning"></td>
                    <td></td>
                    <td class="totals">Total Deduction</td>
                    <td class="col-right totals" id="totalDeduction"></td>
                </tr>
            </tfoot>

        </table>

    </div>
    <div class="emp_payslipnet-wrapper">

        <div class="emp-slip-net-summary emp_payslipnet-card">

            <div class="emp-slip-net-label emp_payslipnet-label">
                Net Payable
            </div>

            <div class="emp-slip-net-amount emp_payslipnet-amount" id="netPay">
                ₹ 0.00
            </div>

        </div>

        <div class="small emp_payslipnet-note">
            This is a computer generated payslip.
        </div>

    </div>
    </body>
    </html>

    <script>

         $(document).ready(function () {
             bindLastThreeMonths();
             $("#ddlMonth").change(function () {
                 let selectedDate = $(this).val();
                 loadPayslipDetails(selectedDate);
             });

             $('#btn_downloadslip').on('click', function(){
                 downloadSalarySlipPDF();
             });

             loadPayslipDetails($("#ddlMonth").val());
         });

          function bindLastThreeMonths() {
            const ddl = $("#ddlMonth");
            ddl.empty();

            const now = new Date();

            for (let i = 1; i <= 4; i++) {   // start from 1 to skip current month

                let d = new Date(now.getFullYear(), now.getMonth() - i, 1);

                let value = d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, '0') + "-01";

                let text = d.toLocaleString('default', { month: 'long', year: 'numeric' });

                ddl.append(`<option value="${value}">${text}</option>`);
            }
        }

        function loadPayslipDetails(vdate) {

         $.ajax({
                 url: '/EmpPayslip/PayslipDetails',
                 type: 'GET',
                 data: { vdate: vdate},
                 dataType: 'json',
                 success: function (res) {
                     debugger;
                     if (!res.success) {
                         toastr.success(res.message);
                         clearPayslipForm();
                         return;
                     }
                     const p = res.payslip;
                     console.log('p',p);
                     console.log("EMP_ID:", res.empId);
                     $("#companyName").text(p.company);
                     $("#Compddress").text(p.address);
                     $("#salaryMonth").text(
                         new Date(p.sDate).toLocaleString('default', { month: 'short', year: 'numeric' })
                     );

                     $("#empName").text(p.name);
                     $("#cardNo").text(p.cardNo);
                     $("#fatherName").text(p.fatherName);
                     $("#department").text(p.department);
                     $("#designation").text(p.designation);
                     $("#joinDate").text(p.joinDate);

                     $("#pfNo").text(p.pfNo || "-");
                     $("#esiNo").text(p.esiNo || "-");
                     $("#workDay").text(p.workDay);
                     $("#leaveDay").text(p.leaveDay);

                     const tbody = $("#earningBody").empty();

                     tbody.append(`
                         <tr>
                             <td>Basic</td><td class="col-right">${p.mBasic}</td><td class="col-right">${p.basic}</td>
                             <td></td><td>P.F.</td><td class="col-right">${p.pf}</td>
                         </tr>
                         <tr>
                             <td>HRA</td><td class="col-right">${p.mhra}</td><td class="col-right">${p.hra}</td>
                             <td></td><td>ESI</td><td class="col-right">${p.esi}</td>
                         </tr>
                         <tr>
                             <td>Conveyance</td><td class="col-right">${p.mConveyance}</td><td class="col-right">${p.conv}</td>
                             <td></td><td>Income Tax</td><td class="col-right">${p.incomeTax}</td>
                         </tr>




                         <tr>
                             <td>Other Allowance</td><td class="col-right">${p.mOtherAllowance}</td><td class="col-right">${p.otherAllowance}</td>
                                 <td></td><td>PROfessional Tax</td><td class="col-right">${p.proF_TAX}</td>
                   
                         </tr>


                        <tr>
                        <td>Festival Ammount</td><td class="col-right"></td><td class="col-right">${p.festival}</td>
                            <td></td><td>Advance Salary Tax</td><td class="col-right">${p.advsal}</td>
                        </tr>



                     `);

                     const gross = (+p.mBasic + +p.mhra + +p.mConveyance + +p.mOtherAllowance);
                     const earn = (+p.basic + +p.hra + +p.conv + +p.otherAllowance + + p.festival );
                     const ded = (+p.pf + +p.esi + +p.incomeTax + +p.proF_TAX + +p.advsal);

                     $("#totalGross").text(gross.toFixed(2));
                     $("#totalEarning").text(earn.toFixed(2));
                     $("#totalDeduction").text(ded.toFixed(2));
                     $("#netPay").text((earn - ded).toFixed(2));
                 }
             });
         }


        function clearPayslipForm() {

            $("#companyName").text("");
            $("#Compddress").text("");
            $("#salaryMonth").text("");

            // clear employee details
            $("#empName").text("");
            $("#cardNo").text("");
            $("#fatherName").text("");
            $("#department").text("");
            $("#designation").text("");
            $("#joinDate").text("");

            // clear PF / ESI
            $("#pfNo").text("");
            $("#esiNo").text("");
            $("#workDay").text("");
            $("#leaveDay").text("");

            // clear salary table
            $("#earningBody").empty();

            // reset totals
            $("#totalGross").text("");
            $("#totalEarning").text("");
            $("#totalDeduction").text("");

            // reset net pay
            $("#netPay").text("₹ 0.00");

            // hide logo if needed
            $("#companyLogo").hide();

        }

        
     async function downloadSalarySlipPDF() {

        try {

            if (!window.jspdf) {
                alert("PDF library not loaded");
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF("p", "mm", "a4");

            let startX = 10;
            let endX = 200;
            let y = 10;

            // ===============================
            // SAFE TEXT HELPERS
            // ===============================
            const getText = (selector) => ($(selector).text().trim() || "-");

            const getNumber = (selector) => {
                return parseFloat($(selector).text().replace(/[^\d.]/g, '')) || 0;
            };

            // ===============================
            // LOAD IMAGE SAFELY (NO CORS ISSUE)
            // ===============================
            async function loadImageAsBase64(url) {
                return new Promise((resolve, reject) => {
                    const img = new Image();
                    img.crossOrigin = "Anonymous";

                    img.onload = function () {
                        const canvas = document.createElement("canvas");
                        canvas.width = img.naturalWidth;
                        canvas.height = img.naturalHeight;

                        const ctx = canvas.getContext("2d");
                        ctx.drawImage(img, 0, 0);

                        resolve(canvas.toDataURL("image/jpeg"));
                    };

                    img.onerror = reject;
                    img.src = url + "?v=" + new Date().getTime(); // cache bust
                });
            }

            // ===============================
            // LOGO (SAFE LOAD)
            // ===============================
            try {
                const logoUrl = $("#companyLogo").attr("src");

                if (logoUrl) {
                    const base64Logo = await loadImageAsBase64(logoUrl);

                    const logoWidth = 50;
                    const logoHeight = 25;
                    const logoX = 105 - (logoWidth / 2);

                    doc.addImage(base64Logo, 'JPEG', logoX, y, logoWidth, logoHeight);
                    y += logoHeight + 5;
                }
            } catch (e) {
                console.warn("Logo skipped:", e);
            }

            // ===============================
            // COMPANY NAME
            // ===============================
            doc.setFont("times", "bold");
            doc.setFontSize(16);
            doc.text(getText("#companyName"), 105, y, { align: "center" });

            // ===============================
            // ADDRESS
            // ===============================
            doc.setFont("times", "normal");
            doc.setFontSize(10);

            let address = getText("#Compddress");
            let splitAddress = doc.splitTextToSize(address, 120);

            y += 5;
            doc.text(splitAddress, 105, y, { align: "center" });

            y += splitAddress.length * 5 + 5;

            // ===============================
            // BORDER
            // ===============================
            doc.rect(startX, y, 190, 150);

            // ===============================
            // TITLE
            // ===============================
            doc.setFont("times", "bold");
            doc.text("Pay Slip (for the month of " + getText("#salaryMonth") + ")", 105, y + 8, { align: "center" });

            y += 15;

            doc.setFont("times", "normal");
            doc.setFontSize(10);

            // ===============================
            // EMPLOYEE DETAILS
            // ===============================
            const empRows = [
                ["EMP Code", getText("#cardNo"), "Days", getText("#workDay")],
                ["Name", getText("#empName"), "Payable Days", getText("#workDay")],
                ["Designation", getText("#designation"), "Department", getText("#department")],
                ["PF No", getText("#pfNo"), "ESI No", getText("#esiNo")]
            ];

            empRows.forEach((row, index) => {
                let rowY = y + index * 6;

                doc.text(row[0] + " :", 15, rowY);
                doc.text(row[1], 45, rowY);

                doc.text(row[2] + " :", 110, rowY);
                doc.text(row[3], 150, rowY);

                doc.line(startX, rowY + 2, endX, rowY + 2);
            });

            y += empRows.length * 6 + 6;

            // ===============================
            // TABLE BOX
            // ===============================
            const boxStartY = y;
            const boxHeight = 35;

            doc.rect(startX, boxStartY, 190, boxHeight);
            doc.line(105, boxStartY, 105, boxStartY + boxHeight);
            doc.line(startX, boxStartY + 6, endX, boxStartY + 6);

            doc.setFont("times", "bold");
            doc.text("EARNINGS", 15, boxStartY + 4);
            doc.text("DEDUCTIONS", 110, boxStartY + 4);

            doc.setFont("times", "normal");

            const getCell = (row, col) =>
                $("#earningBody tr:eq(" + row + ") td:eq(" + col + ")").text() || "0.00";

            const labelsE = ["Basic", "HRA", "Conveyance", "Other Allowance" , "Festival Ammount"];
            const labelsD = ["PF", "ESI", "Income Tax",	"PROfessional Tax" ,"Advance Salary Tax" ];

              for (let i = 0; i < labelsE.length; i++) {  // loop through all earnings
        let rowY = boxStartY + 10 + i * 6;

        doc.text(labelsE[i], 15, rowY);
        doc.text(getCell(i, 2), 95, rowY, { align: "right" });

        if (i < labelsD.length) {
            doc.text(labelsD[i], 110, rowY);
            doc.text(getCell(i, 5), 195, rowY, { align: "right" });
        }
    }

            y = boxStartY + boxHeight + 8;

            // ===============================
            // TOTALS
            // ===============================
            doc.setFont("times", "bold");

            doc.text("Total Earnings :", 110, y);
            doc.text(getText("#totalEarning"), 195, y, { align: "right" });

            y += 6;

            doc.text("Total Deduction :", 110, y);
            doc.text(getText("#totalDeduction"), 195, y, { align: "right" });

            y += 8;
            doc.line(startX, y, endX, y);

            // ===============================
            // NET SALARY
            // ===============================
            y += 6;

            doc.setFontSize(13);
            doc.text("NET SALARY :", 120, y);
             doc.text("Rs. " + getText("#netPay"), 195, y, { align: "right" });

            // ===============================
            // AMOUNT IN WORDS
            // ===============================
            y += 10;

            doc.setFontSize(9);
            doc.setFont("times", "italic");

            const netPayAmount = getNumber("#netPay");
            const netPayInWords = numberToWords(netPayAmount);

            doc.text("Amount in Words: " + netPayInWords, 15, y);

            y += 6;

            doc.text("*This is a system generated pay slip. No signature required.", 15, y);

            // ===============================
            // SAVE
            // ===============================
            const monthText = getText("#salaryMonth").replace(/\s+/g, "_");

            doc.save("Payslip_" + monthText + ".pdf");

        } catch (err) {
            console.error("PDF Error:", err);
            alert("Failed to generate PDF. Please try again.");
        }
    }


    function numberToWords(amount) {
         const ones = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"];
         const teens = ["Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
         const tens = ["", "Ten", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];
         const thousands = ["", "Thousand", "Lakh", "Crore"];

         function convertHundred(num) {
             let str = "";
             if (num > 99) {
                 str += ones[Math.floor(num / 100)] + " Hundred ";
                 num = num % 100;
             }
             if (num > 10 && num < 20) {
                 str += teens[num - 11] + " ";
             } else {
                 str += tens[Math.floor(num / 10)] + " ";
                 str += ones[num % 10] + " ";
             }
             return str.trim();
         }

         function convertNumber(num) {
             if (num === 0) return "Zero";

             let word = "";
             let i = 0;

             while (num > 0) {
                 let part;
                 if (i === 0) {
                     part = num % 1000;
                     num = Math.floor(num / 1000);
                 } else {
                     part = num % 100;
                     num = Math.floor(num / 100);
                 }

                 if (part > 0) {
                     word = convertHundred(part) + " " + thousands[i] + " " + word;
                 }
                 i++;
             }
             return word.trim();
         }

         const [integerPart, decimalPart] = amount.toString().split(".");
         let words = convertNumber(parseInt(integerPart, 10));

         if (decimalPart && parseInt(decimalPart, 10) > 0) {
             words += " and " + convertNumber(parseInt(decimalPart, 10)) + " Paise";
         }

         return words + " Only";
     }


    </script>