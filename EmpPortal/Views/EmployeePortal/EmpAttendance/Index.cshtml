    async function Cheack()
    {
        try{
            const res = await $.ajax({
                url: '/EmpAttendance/CheackParentId',
                type: 'GET'
            });

            if (res.success == true)
            {
          document.querySelector('.empattendancecheck-container').style.display = 'block'; // or 'flex'
                $("#chkMultiple").prop("checked", false);
                $(".calendar-wrapper").show();
                $("#tbl_multiuser").hide();
                $("#multiUserSection").hide();
                $('#empattendancecheckUserSearch').hide();
                $('#lbl_selecteduser').hide();
                $('#calendarTable').show();
                $('#BTN_LoadData').show();
                loadAttendanceDetails($("#monthSelect").val());

            }
            else
            {
               document.querySelector('.empattendancecheck-container').style.display = 'none';
                $("#tbl_multiuser").hide();
                $('#lbl_ViewType').hide();
                $('#chkSelf').hide();
                $('#chkMultiple').hide();
                $('#lbl_self').hide();
                $('#lbl_multiuser').hide();
                $('#empattendancecheckUserSearch').hide();
                $('#lbl_selecteduser').hide();
                $('#BTN_LoadData').hide();

                loadAttendanceDetails($("#monthSelect").val());

            }

            console.log("res" ,res);
        }
        catch(ex){
            alert(ex.message);
        }
    }


    async function LoadMultipleEmpdata(month, selectedEmpIds) {

        try {

            // 🔹 Load Attendance + Holidays
            const [res, holidayRes] = await Promise.all([
                $.ajax({
                    url: '/EmpAttendance/GetMULTIPLEEMPAttendanceDetails',
                    type: 'GET',
                    traditional: true,
                    data: {
                        month: month,
                        EMPID: selectedEmpIds
                    }
                }),
                $.ajax({
                    url: '/EmpAttendance/CheckNationalHoliday',
                    type: 'GET',
                    data: { month: month }
                })
            ]);

            let holidays = holidayRes.data || [];

            console.log("Attendance:", res);
            console.log("Holidays:", holidays);

            // ===== GENERATE ALL DATES =====
            function getAllDatesOfMonth(monthStr) {

                const [year, monthNum] = monthStr.split('-');
                const totalDays = new Date(year, monthNum, 0).getDate();

                let dates = [];

                for (let d = 1; d <= totalDays; d++) {
                    let day = String(d).padStart(2, '0');
                    let month = String(monthNum).padStart(2, '0');
                    dates.push(`${year}-${month}-${day}`);
                }

                return dates;
            }

            const days = getAllDatesOfMonth(month);

            // ===== HOLIDAY MAP (✅ FIXED + NO DUPLICATE) =====
            let holidayMap = {};

            holidays.forEach(h => {
                let d = h.holidayDate.split('T')[0]; // ✅ no timezone issue

                if (!holidayMap[d]) { // ✅ prevent duplicates
                    holidayMap[d] = (h.name || "").trim();
                }
            });

            // ===== HEADER =====
            let header = `<tr>
                            <th>Emp Code</th>
                            <th>Employee</th>`;

            days.forEach(d => {
                let day = new Date(d).getDate();
                header += `<th>${day}</th>`;
            });

            header += `</tr>`;
            $("#attendanceHead").html(header);

            // ===== NO DATA =====
            if (!res || res.length === 0) {

                $("#multiUserBody").html(`
                    <tr>
                        <td colspan="${days.length + 2}" style="text-align:center;">
                            No record found
                        </td>
                    </tr>
                `);

                toastr.warning("Record not found for this selected month");
                return;
            }

            // ===== GROUP BY EMP =====
            const employees = {};

            res.forEach(item => {

                // ✅ FIX: convert dd-MMM-yyyy → yyyy-MM-dd
                let formattedDate = convertToISO(item.date);

                if (!employees[item.empId]) {
                    employees[item.empId] = {
                        name: item.employeeName || "",
                        dates: {}
                    };
                }

                let status = (item.status || "").toLowerCase();
                let cellClass = "default-cell";

                if (status === "present" || status === "p") {
                    cellClass = "present-cell";
                }
                else if (status === "absent" || status === "a") {
                    cellClass = "absent-cell";
                }
                else if (status === "leave" || status === "l") {
                    cellClass = "leave-cell";
                }
                else if (status === "off" || status === "off" || status === "offday") {
                    cellClass = "offday-cell";
                }

                let statusText = item.status || "";

                let hrsText = "";
                if (item.ahrs) {
                    hrsText = ` (${item.ahrs})`;
                }
                else if (item.bhrs) {
                    hrsText = ` (-${item.bhrs})`;
                }

                let timeText = "";
                if (item.inTime && item.outTime) {
                    timeText = `<br><small>${item.inTime} - ${item.outTime}</small>`;
                }

                let cellContent = "";

                if (statusText) {
                    cellContent += `<b>${statusText}</b>`;
                }

                cellContent += timeText;

                employees[item.empId].dates[formattedDate] = {
                    class: cellClass,
                    content: cellContent
                };
            });

            // ===== BUILD TABLE =====
            let rows = "";

            Object.keys(employees).forEach(empId => {

                rows += `
                    <tr>
                        <td>${empId}</td>
                        <td>${employees[empId].name}</td>
                `;

                days.forEach(d => {

                    let holidayName = holidayMap[d];
                    let empData = employees[empId].dates[d];

                    if (holidayName) {

                        rows += `
                            <td class="holiday-cell">
                                <b>Holiday</b><br>
                                <small>${holidayName}</small>
                            </td>
                        `;
                    }
                    else if (empData) {

                        rows += `
                            <td class="${empData.class}">
                                ${empData.content}
                            </td>
                        `;
                    }
                    else {

                        rows += `<td class="default-cell"></td>`;
                    }
                });

                rows += `</tr>`;
            });

            $("#multiUserBody").html(rows);

        }
        catch (err) {

            console.error("Error:", err);
            toastr.error("Error loading attendance data");
        }
    }


