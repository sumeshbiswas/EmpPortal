    function populateMonthDropdown() {

        const monthSelect = $("#monthSelect");

        const monthNames = [
            "January","February","March","April","May","June",
            "July","August","September","October","November","December"
        ];

        let today = new Date();
        let currentMonth = today.getMonth();
        let currentYear = today.getFullYear();

        monthSelect.empty();

        for (let i = 0; i < 12; i++) {

            let monthIndex = currentMonth - i;
            let year = currentYear;

            if (monthIndex < 0) {
                monthIndex += 12;
                year -= 1;
            }
            let monthValue = `${year}-${(monthIndex + 1).toString().padStart(2,'0')}`;
            let monthText = `${monthNames[monthIndex]} ${year}`;
            monthSelect.append(`<option value="${monthValue}">${monthText}</option>`);
        }
    }

    function loadUserList() {
        $.ajax({
            url: '/EmpAttendance/DDLUserMast',
            type: 'GET',
            success: function (data) {

                let container = $("#userCheckboxList");
                container.empty();

                $.each(data, function (index, user) {

                    let html = `
                        <label class="empattendancecheck-useritem">
                            <input type="checkbox" class="userCheckbox" value="${user.value}">
                            <span>${user.text}</span>
                        </label>
                    `;

                    container.append(html);

                });

            },
            error: function () {
                alert("Unable to load users.");
            }
        });

    }

    function getSelectedUserIds(){
        let users = [];
        $(".userCheckbox:checked").each(function(){
            users.push($(this).val());
        });
        return users;
    }

    /* convert date format */
     function convertToISO(dateStr){

        if(!dateStr) return "";

        /* ISO format */
        if(dateStr.includes("T"))
            return dateStr.split("T")[0];

        /* format 04-Mar-2026 */
        if(dateStr.includes("-")){

            let parts = dateStr.split("-");

            if(parts.length === 3){

                let day = parts[0].padStart(2,'0');
                let monthName = parts[1];
                let year = parts[2];

                let monthNames = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

                let monthIndex = monthNames.indexOf(monthName);

                if(monthIndex !== -1){

                    let month = (monthIndex+1).toString().padStart(2,'0');

                    return `${year}-${month}-${day}`;
                }
            }
        }

        return "";
    }



    /* load calendar */

    async function loadAttendanceDetails(month){

        try{

            $("#attendanceLoader").show();

            $("#calendarBody").hide();


            const [attendanceRes, holidayRes] = await Promise.all([

                $.ajax({

                    url:'/EmpAttendance/GetAttendanceDetails',

                    type:'GET',

                    data:{ month:month }

                }),

                $.ajax({

                    url:'/EmpAttendance/CheckNationalHoliday',

                    type:'GET',

                    data:{ month:month }

                })

            ]);


             let attendance =
                attendanceRes.data ||
                attendanceRes.result ||
                attendanceRes || [];

             let holidays = Array.isArray(holidayRes) ? holidayRes : holidayRes.data || [];


            const calendarBody = $("#calendarBody");

            calendarBody.empty();


            let [year, monthIndex] = month.split("-");

            year = parseInt(year);

            monthIndex = parseInt(monthIndex)-1;


            let firstDay = new Date(year, monthIndex, 1);

            let lastDate = new Date(year, monthIndex+1,0).getDate();

            let startDay = firstDay.getDay();


            let today = new Date();


            /* maps */

            let attendanceMap = {};

            attendance.forEach(x=>{

            let rawDate =
                x.date ||
                x.attendanceDate ||
                x.attDate ||
                x.workDate;

            let d = convertToISO(rawDate);

            if(d)
                attendanceMap[d.trim()] = x;

            });


            let holidayMap = {};

            holidays.forEach(h=>{

                let d = h.holidayDate.split('T')[0];

                holidayMap[d] = h.name;

            });


            /* 🔹 summary counters added */
            let presentCount = 0;
            let leaveCount = 0;
            let absentCount = 0;
            let holidayCount = 0;


            let row = $("<tr></tr>");

            let date = 1;


            for(let i=0;i<startDay;i++){

                row.append('<td class="calendar-cell calendar-empty"></td>');

            }


            while(date<=lastDate){

                if(row.children().length===7){

                    calendarBody.append(row);

                    row = $("<tr></tr>");

                }


                let fullDate =

                `${year}-${(monthIndex+1).toString().padStart(2,'0')}-${date.toString().padStart(2,'0')}`;


                let record = attendanceMap[fullDate];

                let holidayName = holidayMap[fullDate];


                let cellClass="calendar-cell offday";

                let status="";

                let inTime="";

                let outTime="";

                let deduction=""; // FIXED scope


                /* priority */

                if(holidayName){

                    cellClass="calendar-cell holiday";

                    status="Holiday";

                    /* 🔹 count holiday */
                    holidayCount++;

                }


                else if(record){

                    status = record.status || "";

                    inTime = record.inTime || "";

                    outTime = record.outTime || "";


                    let shiftStart="09:30";


                    if(inTime){

                        let inDate = new Date("1970-01-01 "+inTime);

                        let shiftDate = new Date("1970-01-01 "+shiftStart);


                        let lateMinutes = (inDate-shiftDate)/60000;


                        if(lateMinutes>0 && lateMinutes<=30)

                            deduction="0.50";


                        else if(lateMinutes>30)

                            deduction="0.10";

                    }


                    if(status=="P"){

                        cellClass="calendar-cell present";

                        /* 🔹 count present */
                        presentCount++;

                    }


                    else if(status=="A"){

                        cellClass="calendar-cell absent";

                        /* 🔹 count absent */
                        absentCount++;

                    }


                    else if(status=="L"){

                        cellClass="calendar-cell leave";

                        /* 🔹 count leave */
                        leaveCount++;

                    }


                    else if(status=="E"){

                        cellClass="calendar-cell earnedleave";

                        /* 🔹 earned leave counted in leave */
                        leaveCount++;

                    }
                }


                let highlightToday=

                (date===today.getDate() &&

                 monthIndex===today.getMonth() &&

                 year===today.getFullYear())

                 ? "today-border":"";


                let html=`

                    <div class="cell-top">

                        <span class="date-left">${date}</span>

                        <span class="status-right">

                            ${holidayName ? "Holiday" : status}

                            ${deduction ? `<span class="late-red"> -${deduction}</span>`:""}

                        </span>

                    </div>

                `;


                if(holidayName){

                    html+=`

                    <div class="time-subtext">

                        ${holidayName}

                    </div>

                    `;

                }


                else if(inTime || outTime){

                    html+=`

                    <div class="time-subtext">

                        ${inTime}

                        ${inTime && outTime ? " To ":""}

                        ${outTime}

                    </div>

                    `;

                }


                row.append(`

                    <td class="${cellClass} ${highlightToday}">

                        ${html}

                    </td>

                `);


                date++;

            }


            while(row.children().length<7){

                row.append('<td class="calendar-cell calendar-empty"></td>');

            }


            calendarBody.append(row);


            /* 🔹 update summary cards */

            $("#presentCount").text(presentCount);

            $("#leaveCount").text(leaveCount);

            $("#absentCount").text(absentCount);

            $("#holidayCount").text(holidayCount);


            $("#attendanceLoader").hide();

            $("#calendarBody").show();

        }

        catch(e){

            $("#attendanceLoader").hide();

            console.log(e);

        }

    }




