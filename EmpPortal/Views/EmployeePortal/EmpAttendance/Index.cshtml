@{
    ViewBag.Title = "Employee Attendance";
    Layout = "~/Views/Shared/EmployeeLayout.cshtml";
}

<div class="emp-bar">
    <div class="emp-main-title">
        <i class="fa-solid fa-calendar-check"></i>
        <span>Employee Attendance</span>
    </div>
</div>

<fieldset class="emp_attendancenew-fieldset">

    <legend class="emp_attendancenew-legend">
        Attendance Filter
    </legend>

    <div class="emp_attendancenew-row">

        <div class="emp_attendancenew-inline-group">

            <label for="ddlMonth" class="emp_attendancenew-label-inline">
                Select Month
            </label>

            <select id="monthSelect" class="form-select emp_attendancenew-select">
            </select>

        </div>

    </div>

</fieldset>
<div class="emp_attendancenew-summary-wrapper" id="emp_attendancenew-summary">

    <div class="emp_attendancenew-card">
        <div class="emp_attendancenew-card-icon present">
            <i class="fa-solid fa-check"></i>
        </div>

        <div>
            <div class="emp_attendancenew-card-title">Present</div>
            <div class="emp_attendancenew-card-value" id="presentCount">0</div>
        </div>
    </div>


    <div class="emp_attendancenew-card">
        <div class="emp_attendancenew-card-icon leave">
            <i class="fa-solid fa-calendar-xmark"></i>
        </div>

        <div>
            <div class="emp_attendancenew-card-title">Leave</div>
            <div class="emp_attendancenew-card-value" id="leaveCount">0</div>
        </div>
    </div>


    <div class="emp_attendancenew-card">
        <div class="emp_attendancenew-card-icon absent">
            <i class="fa-solid fa-user-xmark"></i>
        </div>

        <div>
            <div class="emp_attendancenew-card-title">Absent</div>
            <div class="emp_attendancenew-card-value" id="absentCount">0</div>
        </div>
    </div>


    <div class="emp_attendancenew-card">
        <div class="emp_attendancenew-card-icon holiday">
            <i class="fa-solid fa-umbrella-beach"></i>
        </div>

        <div>
            <div class="emp_attendancenew-card-title">Holiday</div>
            <div class="emp_attendancenew-card-value" id="holidayCount">0</div>
        </div>
    </div>

</div>

