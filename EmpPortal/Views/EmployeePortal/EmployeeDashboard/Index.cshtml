@{
    ViewBag.Title = "Employee Portal Dashboard";
    Layout = "~/Views/Shared/EmployeeLayout.cshtml";
}
<style>

    .emp-wedding-anniversary-header {
        background-color: #e91e63; 
    }

    .emp-leave-flex {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        height: 260px;
    }

    /* donut left */
    .emp-leave-donut {
        width: 45%;
        height: 100%;
    }

    /* right details */
    .emp-leave-details {
        width: 55%;
    }

    .emp-leave-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        font-size: 14px;
        color: #1d1d1d;
    }

    /* color dot */
    .emp-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: inline-block;
    }

    /* colors matching chart */
    .clApplied {
        background: #EF5350;
    }

    .clBalance {
        background: #66BB6A;
    }

    .elApplied {
        background: #FFCA28;
    }

    .elBalance {
        background: #42A5F5;
    }

    /* bold number */
    .emp-leave-row b {
        font-size: 18px;
        color: #0f263e;
    }

    .emp-leave-total {
        margin-bottom: 12px;
        font-size: 15px;
        color: #0e243b;
    }

        .emp-leave-total div {
            margin-bottom: 6px;
        }

    .emp-divider {
        border: 0;
        border-top: 1px solid rgba(255,255,255,0.1);
        margin: 10px 0 15px;
    }

    .leave_total{
        color: #198754;
    }
</style>

<section class="empdashboardheading">

    <div class="emp-heading-top">
        <div>
            <h5>
                <span class="emp-icon-wrapper">
                    <i class="fa-solid fa-user"></i>
                </span><span class="emp_mainheading">Employee Dashboard</span>
            </h5>
        </div>

        <div class="emp-welcome">
            Welcome back, <strong id="lbl_EmpNameTop"></strong> 👋
        </div>
    </div>
</section>

<!-- LEAVE MANAGEMENT BAR -->
<section class="emp-leave-bar">
    <div class="emp-leave-wrapper">
        <div class="emp-leave-title">
            <i class="fa-solid fa-calendar-check"></i>
            <span>Leave Management</span>
        </div>
        <div class="emp-leave-dropdown">
            <div class="emp-leave-buttons">
                <button id="btn_leaveapply" style="display:none;" class="emp-approval-btn" onclick="window.location.href='@Url.Action("Index", "EmpLeaveApprovalList")'">
                    <i class="fa-solid fa-clipboard-check"></i> Leave Approval
                </button>
                <button class="emp-leave-btn" onclick="toggleLeaveDropdown()">
                    <i class="fa-solid fa-calendar-days"></i> Manage Leave<i class="fa-solid fa-chevron-down"></i>
                </button>
            </div>
            <div class="emp-leave-menu" id="empLeaveMenu">
                <a href="#" id="btnRequestModal" data-toggle="modal" data-target="#requestLeaveModal">
                    <i class="fa-solid fa-paper-plane"></i>Apply Leave
                </a>
                <a href="#" data-toggle="modal" data-target="#leaveHistoryModal" id="btn_LeaveHistory">
                    <i class="fa-solid fa-clock-rotate-left"></i>Leave History
                </a>
            </div>
        </div>
    </div>
</section>
<!-- EMP Leave Request Modal -->
<div class="modal fade emp-leave-modal" id="requestLeaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered emp-modal-dialog">
        <div class="modal-content emp-modal-content">
            <!-- Header -->
            <div class="emp-modal-header">
                <div>
                    <h5 class="emp-modal-title">
                        <i class="fa-solid fa-calendar-check me-2"></i> Leave Request
                    </h5>
                    <div class="emp-balance-wrapper mt-2">
                        <span class="emp-badge emp-cl-badge">
                            CL Balance: <span id="LblCL">0</span>
                        </span>
                        <span class="emp-badge emp-el-badge">
                            EL Balance: <span id="LblEL">0</span>
                        </span>
                    </div>
                </div>
                <button type="button" class="close emp-close-btn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <!-- Body -->
            <div class="emp-modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                        <div class="emp-form-group">
                            <label>From Date</label>
                            <input type="date" class="emp-form-control" id="fromDate">
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                        <div class="emp-form-group">
                            <label>To Date</label>
                            <input type="date" class="emp-form-control" id="toDate">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6 col-md-6 col-lg-6 col-xl-6">
                        <div class="emp-form-group">
                            <label>Leave Type</label>
                            <select class="emp-form-control" id="ddlLeaveType">
                                <option value="">Select Leave Type</option>
                                <option value="1">Earned Leave</option>
                                <option value="2">Casual Leave</option>
                                <option value="3">Leave Without Pay</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                        <div class="emp-form-group">
                            <label>Reason For Leave</label>
                            <textarea class="emp-form-control" id="requestRemarks" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="offset-0 offset-sm-3 offset-md-4 offset-lg-3 offset-xl-3 col-12 col-sm-6 col-md-4 col-lg-4 col-xl-6">
                        <button type="button" id="SubmitRequest" class="emp-submit-btn">
                            <i class="fa-solid fa-paper-plane"></i> Submit Request
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- EMP leave history Modal -->

<div class="modal fade emp-leave-modal" id="leaveHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content emp-modal-content">
            <!-- Header -->
            <div class="emp-modal-header d-flex align-items-center justify-content-between">
                <!-- Left: Title and Small Text -->
                <div class="d-flex flex-column">
                    <h5 class="emp-modal-title">
                        <i class="fa-solid fa-clock-rotate-left"></i> Leave History
                    </h5>
                    <small class="text-light">Your previous leave records</small>
                </div>

                <!-- Center: Filter Date -->
                <div class="flex-grow-1 text-center">
                    <input type="month" id="Fltr_date" class="form-control">
                </div>

                <!-- Right: Close Button -->
                <button type="button" class="close emp-close-btn" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <!-- Body -->
            <div class="emp-modal-body emp-history-body">
                <div class="emp-history-table-wrapper">
                    <table class="emp-history-table">
                        <thead>
                            <tr>
                                <th style="display:none;">DocID</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Type</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



