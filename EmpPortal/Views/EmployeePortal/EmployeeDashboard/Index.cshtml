<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
        let leaveChartInstance = null;
        let selectedRowData = null;

            /* ===================== DOCUMENT READY ===================== */
        $(document).ready(async function () {
            try {
                Cheack();
                await loadEmployeeDetails();
                await loadLeaveChart();



            } catch (err) {
               toastr.error("Failed to load dashboard data. Please try again later.");
            }

            $('#btn_LeaveHistory').on('click', function () {

                    const input = document.getElementById("Fltr_date");

                    let now = new Date();

                    // Current month
                    let currentYear = now.getFullYear();
                    let currentMonth = String(now.getMonth() + 1).padStart(2, '0');

                    input.value = `${currentYear}-${currentMonth}`;
                    input.max = `${currentYear}-${currentMonth}`;

                    // 3 months back
                    let minDate = new Date();
                    minDate.setMonth(minDate.getMonth() - 3);

                    let minYear = minDate.getFullYear();
                    let minMonth = String(minDate.getMonth() + 1).padStart(2, '0');

                    input.min = `${minYear}-${minMonth}`;

                    document.getElementById('Fltr_date').value = new Date(new Date().getFullYear(), new Date().getMonth()-1,1).toISOString().slice(0,7);

                    fetchLeaveHistory();




                });

            $('#btnRequestModal').on('click', async function () {
            try {
                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveBalances',
                    type: 'GET'
                });

                if (!res.success || !res.data) return;
                 await fetchLeaveHistory();
                $('#LblCL').text(res.data.clBal);
                $('#LblEL').text(res.data.elBal);

            }
            catch (error) {

                toastr.error("Error", error);
            }
        });

            $(document).on("change", ".from-date, .to-date", function () {

            const row = $(this).closest("tr");

            const fromVal = row.find(".from-date").val();
            const toVal = row.find(".to-date").val();

            if (fromVal && toVal) {

                const from = new Date(fromVal);
                const to = new Date(toVal);

                let days = Math.floor((to - from) / (1000 * 60 * 60 * 24)) + 1;

                if (days < 0) days = 0;

                row.find(".days").val(days);
            }

        });

            $('#Fltr_date').on('change', function(){
                const selecteddate  = $('#Fltr_date').val();
              fetchLeaveHistory(selecteddate);
            });

           document.addEventListener("click", function (e) {
                  const dropdown = document.querySelector(".emp-leave-dropdown");
                if (!dropdown.contains(e.target)) {
                 document.getElementById("empLeaveMenu").classList.remove("emp-show");
                }
            });

        /* ===================== LEAVE TYPE CHANGE ===================== */
            $("#ddlLeaveType").change(async function () {
            let leaveCode = $(this).val();
            if (!leaveCode) return;

            try {
                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveBalance',
                    type: 'GET',
                    data: { leaveCode: leaveCode }
                });

                if (res.success) {
                    $("#lblCL").text(res.balCL);
                    $("#lblEL").text(res.balEL);

                    let balCL = parseInt(res.balCL) || 0;
                    let balEL = parseInt(res.balEL) || 0;

                    if (balCL === 0 && balEL === 0)
                        $("#btnSubmitRequest").hide();
                    else
                        $("#btnSubmitRequest").show();
                } else {
                    toastr.info(res.message);
                    $("#btnSubmitRequest").hide();
                }

            } catch (error) {

                toastr.error("Error fetching leave balance:", error)
            }
        });

            $(document).on("change", ".from-date, .to-date", function () {
                const row = $(this).closest("tr");
                const fromVal = row.find(".from-date").val();
                const toVal = row.find(".to-date").val();
                if (fromVal && toVal) {

                    const from = new Date(fromVal);
                    const to = new Date(toVal);

                    if (to < from) {
                        toastr.warning("To Date cannot be earlier than From Date");
                        return;
                    }
                    let days = Math.floor((to - from) / (1000 * 60 * 60 * 24)) + 1;
                    row.find(".days").val(days);
                }
            });

            $("#fromDate").on("change", function () {
                let fromVal = $(this).val();

                if (fromVal) {
                    // Restrict To Date selection
                     $("#toDate").attr("min", fromVal);
                    }
                });

            $("#toDate").on("change", function () {
                let fromVal = $("#fromDate").val();
                let toVal = $(this).val();


                if(!fromVal)
                {
                  toastr.warning("First Select From Date.");
                  $('#toDate').val('');
                  return;
                }




                if (fromVal && toVal) {
                    if (new Date(toVal) < new Date(fromVal)) {
                        toastr.warning("To Date cannot be earlier than From Date");
                        $(this).val(""); // reset invalid value
                    }
                }
            });

        /* ===================== SUBMIT REQUEST ===================== */

          $("#SubmitRequest").click(async function (e) {
                e.preventDefault();
                // Gather form values
                let model = {
                    FromDate: $("#fromDate").val(),
                    ToDate: $("#toDate").val(),
                    LeaveType: $("#ddlLeaveType").val(),
                    LeaveTypeName: $("#ddlLeaveType option:selected").text(),
                    Remarks: $("#requestRemarks").val()
                };

                // Check all fields are filled
                if (!model.FromDate || !model.ToDate || !model.LeaveType || !model.Remarks) {
                    toastr.warning("Please fill all fields");
                    return;
                }

                // Parse dates
                const fromDate = new Date(model.FromDate);
                const toDate = new Date(model.ToDate);

                if (toDate < fromDate) {
                    toastr.warning("To Date cannot be before From Date");
                    return;
                }

                // Calculate total leave days
                let totalDays = Math.floor((toDate - fromDate) / (1000 * 60 * 60 * 24)) + 1;

                // Get leave balances (trimmed and parsed to float)
                const elBalance = parseFloat($('#LblEL').text().trim());
                const clBalance = parseFloat($('#LblCL').text().trim());

                // Check against leave type
                const leaveType = parseInt(model.LeaveType);

                if (leaveType === 1 && totalDays > elBalance) {
                    toastr.info("You have only " + elBalance + " Earned Leave");
                    return;
                }

                if (leaveType === 2 && totalDays > clBalance) {
                    toastr.info("You have only " + clBalance + " Casual Leave");
                    return;
                }

                // Submit the leave request
                try {
                    const res = await $.ajax({
                        url: '/EmployeeDashboard/SubmitLeaveRequest',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(model)
                    });

                    if (res.success === true) {
                        toastr.success("Leave Request submitted successfully!");

                        // Close modal after short delay
                        await new Promise(resolve => setTimeout(resolve, 1500));
                        const modalElement = document.getElementById('requestLeaveModal');
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
                        modalInstance.hide();

                        // Clear form
                        $('#requestLeaveModal').find('input, textarea, select').val('');

                        await loadLeaveChart();
                    } else {
                        toastr.error(res.message);
                    }

                } catch (error) {
                    toastr.error("Server error");

                }
            });

        });

        /* ===================== DROPDOWN ===================== */

        async function Cheack()
            {
                try{
                    const res = await $.ajax({
                        url: '/EmpAttendance/CheackParentId',
                        type: 'GET'
                    });

                    if (res.success == true)
                    {
                      $('#btn_leaveapply').show();
                    }
                    else
                    {
                      $('#btn_leaveapply').hide();
                    }

                }
                catch(ex){
                    toastr.error(ex.message);
                }
            }

        function toggleLeaveDropdown() {
            document.getElementById("empLeaveMenu").classList.toggle("emp-show");
        }

        document.addEventListener("click", function (e) {
            const dropdown = document.querySelector(".emp-leave-dropdown");
            if (dropdown && !dropdown.contains(e.target)) {
                document.getElementById("empLeaveMenu")?.classList.remove("emp-show");
            }
        });

        function toggleLeaveDropdown() {
            document.getElementById("empLeaveMenu").classList.toggle("emp-show");
        }

        /* ===================== LOAD EMPLOYEE DETAILS ===================== */
        async function loadEmployeeDetails() {
            try {
                const response = await $.ajax({
                    url: '/EmployeeDashboard/EmployeeDetails',
                    type: 'GET',
                    dataType: 'json'
                });

                if (response?.employee) {
                const emp = response.employee;

                console.log("emp", emp);

                $("#lbl_EmpID").text(emp.code);
                $("#lbl_EmpNameTop").text(emp.fullName);
                $("#lblEmpName").text(emp.fullName);
                $("#lblempDesignation").html("<strong>Designation:</strong> " + emp.designationName);
                $("#lblEmpdept").text(emp.departmentName);

                if (emp.active == 1) {
                    $('#Emp_status').text("Active");
                } else {
                    $('#Emp_status').text("DeActive");
                }

                // IMAGE
                if (emp.imagebyte) {
                    $("#UserImg").attr("src", "data:image/png;base64," + emp.imagebyte);
                } else {
                    $("#UserImg").attr("src", "/images/user.png");
                }

                var currentYear = new Date().getFullYear();
                $('#YearSumary').text(currentYear + " Summary");

                if (emp.email?.trim()) {
                    $("#lblEmail").html(`<a href="mailto:${emp.email}">${emp.email}</a>`);
                } else {
                    $("#lblEmail").text("Not Available");
                }

                // DOB
                if (emp.dob) {
                    const dobDate = new Date(emp.dob);
                    $("#dobContent").html(`
                        <p class="upcoming_heading">${HolidayformatDate(dobDate,true)}</p>
                        <p class="upcoming_subheading">Happy Birthday! 🎉</p>
                    `);
                    $("#dobCard").show();
                }

                // Work Anniversary
                if (emp.joiN_DATE) {
                    const joiN_DATE = new Date(emp.joiN_DATE);
                    $("#domContent").html(`
                        <p class="upcoming_heading">${HolidayformatDate(joiN_DATE, true)}</p>
                        <p class="upcoming_subheading">Happy Work Anniversary! 🎊</p>
                    `);
                    $("#domCard").show();
                }

                // ✅ FIXED: Wedding Anniversary (inside block)
                if (emp.dom) {
                    const dom = new Date(emp.dom);
                    $("#weddingAnnivContent").html(`
                        <p class="upcoming_heading">${HolidayformatDate(dom, true)}</p>
                        <p class="upcoming_subheading">Happy Wedding Anniversary! 🎊</p>
                    `);
                    $("#doaCard").show();
                }
                else
                {
                   $("#doaCard").hide();
                }
            }


                if (response?.holidays?.length > 0) {
                    loadUpcomingHoliday(response.holidays);
                } else {
                    $("#dHoliday").html("<p>No holidays found</p>");
                }

            } catch (error) {
                toa.error("Unable to load employee details:", error);
            }
        }


        /* ===================== LOAD HOLIDAYS ===================== */
     function loadUpcomingHoliday(holidays) {

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            const upcoming = holidays
                .map(h => ({
                    name: h.name,
                    date: new Date(h.holidayDate)
                }))
                .filter(h => h.date >= today)
                .sort((a, b) => a.date - b.date);

            if (upcoming.length === 0) {
                $("#dHoliday").html("<p>No upcoming holidays</p>");
                return;
            }

            let html = "<ul class='list-unstyled'>";
            upcoming.forEach(h => {
                html += `
                    <li>
                        <strong class="upcoming_heading">${h.name}</strong><br/>
                        <small class="upcoming_subheading">${formatDate(h.date, true)}</small>
                    </li>
                    <hr/>
                `;
            });
            html += "</ul>";

            $("#dHoliday").html(html);
        }

