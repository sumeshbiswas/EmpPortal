      function drawLeaveChart(elBal, clBal, elApplied, clApplied) {

        elBal = Math.max(0, elBal);
        clBal = Math.max(0, clBal);
        elApplied = Math.max(0, elApplied);
        clApplied = Math.max(0, clApplied);

        const totalel = elBal + elApplied;
        const totalcl = clBal + clApplied;

        const ctx = document.getElementById('leaveChart');

        if (leaveChartInstance)
            leaveChartInstance.destroy();

        leaveChartInstance = new Chart(ctx, {

            type: 'doughnut',   // changed from bar

            data: {

                labels: [
                    'CL Applied',
                    'CL Balance',
                    'EL Applied',
                    'EL Balance'
                ],

                datasets: [

                    {
                        label: 'Applied Leave',
                        data: [clApplied, clBal, elApplied, elBal],

                        backgroundColor: [

                            '#EF5350',
                            '#66BB6A',
                            '#FFCA28',
                            '#42A5F5'
                        ]
                    }
                ]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: '70%',   // donut thickness

                plugins: {

                    legend: {

                        display: false   // hide default legend
                    }
                }
            }
        });

        /* show numbers on right side */

        document.getElementById("clAppliedCount").innerText = clApplied;
        document.getElementById("clBalanceCount").innerText = clBal;
        document.getElementById("elAppliedCount").innerText = elApplied;
        document.getElementById("elBalanceCount").innerText = elBal;

        document.getElementById("totalCL").innerText = totalcl;
        document.getElementById("totalEL").innerText = totalel;
    }

    async function fetchLeaveHistory(selecteddate) {
            try {
               
                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveHistoryData',
                    data : {selecteddate : selecteddate},
                    type: 'GET'
                });

                const data = res.data || [];
                $(".emp-history-table tbody").empty();

                data.forEach((item, index) => {
                    addRow({ ...item, index });
                });
            } catch (error) {
                toastr.error("Error fetching leave history:", error);
            }
        }

    function addRow(data = {}) {
        const leaveTypeClass = getLeaveTypeClass(data.leaveType);
        const statusClass = getStatusClass(data.status);
        data.index = data.index !== undefined ? data.index : rowIndex++;
        let days = "";
        if (data.fromDate && data.toDate) {
            const from = new Date(data.fromDate);
            const to = new Date(data.toDate);
            days = Math.floor((to - from) / (1000 * 60 * 60 * 24)) + 1;
        }

        const row = `
            <tr data-row="${data.index}">

                <td style="display:none;">
                    <input type="text"
                           class="form-control"
                           style="width:120px"
                           id="DocID_${data.index}"
                           value="${data.doC_ID}"
                           readonly>
                </td>

                <td>
                    <input type="date"
                           class="form-control from-date"
                           id="from_${data.index}"
                           value="${data.fromDate || ''}"
                           readonly>
                </td>

                <td>
                    <input type="date"
                           class="form-control to-date"
                           id="to_${data.index}"
                           value="${data.toDate || ''}"
                           readonly>
                </td>

                <td>
                    <select class="form-control leave-type-badge ${leaveTypeClass}"
                            id="type_${data.index}"
                            style="width:120px"
                            readonly>
                        <option value="">Select Leave</option>
                        <option value="Earned Leave" ${data.leaveType === 'Earned Leave' ? 'selected' : ''}>Earned Leave</option>
                        <option value="Casual Leave" ${data.leaveType === 'Casual Leave' ? 'selected' : ''}>Casual Leave</option>
                        <option value="Earn Leave" ${data.leaveType === 'Earn Leave' ? 'selected' : ''}>Earn Leave</option>
                        <option value="Leave Without Pay" ${data.leaveType === 'Leave Without Pay' ? 'selected' : ''}>Leave Without Pay</option>
                    </select>
                </td>

                <td>
                    <input type="number"
                           class="form-control days leave-days"
                           style="width:40px"
                           id="days_${data.index}"
                           value="${days}"
                           readonly>
                </td>

                <td>
                    <input type="text"
                           class="leave-status-badge ${statusClass}"
                           style="width:120px"
                           id="status_${data.index}"
                           value="${data.status || 'Pending'}"
                           readonly>
                </td>

                <td>
                    <i class="fa fa-edit btn-empedit"
                       title="Edit Leave"
                       onclick="editRow(${data.index}, this)">
                    </i>

                    <i class="fa fa-save btn-empsave"
                       title="Save Leave Request"
                       onclick="updateLeave(${data.index}, this)">
                    </i>
                </td>

            </tr>
        `;

        $(".emp-history-table tbody").append(row);
    }

    function editRow(index, el) {
        const row = $(el).closest("tr");
        row.find(`#from_${index}`).prop("readonly", false);
        row.find(`#to_${index}`).prop("readonly", false);
        row.find(`#status_${index}`).prop("readonly", false);
        row.addClass("editing-row");
    }

    async function updateLeave(index, el) {
            try {

                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveBalances',
                    type: 'GET'
                });

                if (!res.success || !res.data) return;
                clBal1 = res.data.clBal;
                elBal1 =  res.data.elBal ;

                const row = $(el).closest("tr");

                const rowData = {
                    index: index,
                    DocID: row.find("#DocID_" + index).val(),
                    fromDate: row.find("#from_" + index).val(),
                    toDate: row.find("#to_" + index).val(),
                    leaveType: row.find("#type_" + index).val(),
                    days: row.find("#days_" + index).val(),
                    status: row.find("#status_" + index).val()
                };

                if (rowData.status === 'Approved') {
                    toastr.warning("Your leave has already been approved. No further changes are allowed.");
                    return;
                }

                if (rowData.leaveType === 'Earned Leave') {
                    if (rowData.days > elBal1) {
                        toastr.warning("Leave days cannot be greater than the available Earned Leave balance (" + elBal1 + ").");
                        return;
                    }
                }

                else if (rowData.leaveType === 'Casual Leave') {
                    if (rowData.days > clBal1) {
                        toastr.warning("Leave days cannot be greater than the available Casual Leave balance (" + clBal1 + ").");
                        return;
                    }
                }

                $.ajax({
                    url: "/EmployeeDashboard/UpdateLeave",
                    type: "POST",
                    data: rowData,
                    success: function (res) {
                        toastr.success("Leave update Succesfull")
                    },
                    error: function (err) {

                        toastr.error("Error", err);
                    }
                });

            }
            catch (error) {
                toastr.error("Error", err);
            }
        }

    function getLeaveTypeClass(leaveType) {
        switch(leaveType) {
            case 'Earned Leave':
                return 'leavehistory-earned';
            case 'Casual Leave':
                return 'leavehistory-casual';
            case 'Earn Leave':
                return 'leavehistory-earn';
            case 'Leave Without Pay':
                return 'leavehistory-lwp';
            default:
                return '';
        }
    }

    function getStatusClass(status) {
        switch(status) {
            case 'Pending':
                return 'leavehistory-pending';
            case 'Approved':
                return 'leavehistory-approved';
            case 'Rejected':
                return 'leavehistory-rejected';
            default:
                return 'leavehistory-default';
        }
    }

    function formatDate(dateStr) {
            if (!dateStr) return '';
            const d = new Date(dateStr);
            if (isNaN(d)) return '';
            return d.toISOString().slice(0, 10);
        }


            function HolidayformatDate(date, showYear) {
        // Create a new Date object to avoid mutating the original
        const currentYear = new Date().getFullYear();
        const newDate = new Date(date);

        if (showYear) {
            newDate.setFullYear(currentYear); // Replace year with current year
        }

        return newDate.toLocaleDateString('en-IN', {
            day: 'numeric',
            month: 'long',
            year: showYear ? 'numeric' : undefined
        });
    }

        function HolidayformatDate(date, showYear) {
        if (!date) return '';

        const today = new Date();
        const inputDate = new Date(date);
        if (isNaN(inputDate)) return '';

        // Create date with current year
        let newDate = new Date(
            today.getFullYear(),
            inputDate.getMonth(),
            inputDate.getDate()
        );

        // If date already passed → move to next year
        if (newDate < today) {
            newDate.setFullYear(today.getFullYear() + 1);
        }

        return newDate.toLocaleDateString('en-IN', {
            day: 'numeric',
            month: 'long',
            year: showYear ? 'numeric' : undefined
        });
    }





