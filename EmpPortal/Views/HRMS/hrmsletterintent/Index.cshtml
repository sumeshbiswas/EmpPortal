    // ================= LOAD LETTER INTENT DATA =================

    function hrmsletterintent(code) {

        $.ajax({
            url: '/hrmsletterintent/GethrmsletterintentDetailList',
            type: 'GET',
            data: { code: parseInt(code) },
            success: function (res) {

                if (res && res.letterIntentDetail && res.letterIntentDetail.length > 0) {

                    var data = res.letterIntentDetail[0];

                    $('#DtDocumentDate').val(formatDate(data.v_DATE));
                    $('#DtDiscussDate').val(formatDate(data.discussioN_DATE));
                    $('#EffectiveDate').val(formatDate(data.efF_DATE));
                    $('#DtAcceptanceDate').val(formatDate(data.acceptancE_DATE));
                    $('#DtJoiningDate').val(formatDate(data.joininG_DATE));
                    //$('#ddlEmployeeName').val(data.intenT_NAME).trigger('change');
                    $('#ddlEmployeeName').val(data.intenT_NAME);
                    $('#ddlDepartment').val(data.depT_NAME).trigger('change');
                    $('#ddlDesignation').val(data.desG_NAME).trigger('change');
                    $('#ddlReportingTo').val(data.reportinG_MANAGER).trigger('change');

                    $('#TxtReportLocation').val(data.reporT_LOCATION);
                    $('#NumHandSalary').val(data.takE_HOME_SAL);
                    $('#OtherAmountID').val(data.grosS_SAL);
                }
            }
        });
    }


    // ================= SAFE DATE FORMAT =================

    function formatDate(dateString) {

        if (!dateString) return "";

        let parts = dateString.split('T')[0].split('-');
        return parts[2] + '/' + parts[1] + '/' + parts[0];
    }
</script>

