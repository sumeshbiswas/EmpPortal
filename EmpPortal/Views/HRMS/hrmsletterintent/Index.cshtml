@{
    ViewBag.Title = "HRMS Home";
    Layout = "~/Views/Shared/EmployeeLayout.cshtml";
}
@await Html.PartialAsync("Partial_Wizard")
<div class="form-section active" id="formletterintent">
    <p class="EmpLabel"><span>Intent Letter</span></p>
    <fieldset>

    
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label for="DtDocumentDate">Document Date</label>
                    <input type="text" class="form-control" id="DtDocumentDate" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="ddlEmployeeName">Employee Name</label>

                    <input type="text" class="form-control" id="ddlEmployeeName" />

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label for="ddlDepartment">Department</label>
                <select class="form-control" id="ddlDepartment">
                    <option value="">Select Department</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="ddlDesignation">Designation</label>
                <select class="form-control" id="ddlDesignation">
                    <option value="">Select Designation</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="ddlReportingTo">Reporting To</label>
                <select class="form-control" id="ddlReportingTo">
                    <option value="">Select Reporting To</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="TxtReportLocation">Report Location</label>
                <input type="text" class="form-control" id="TxtReportLocation" />
            </div>
        </div>
       
    </div>
    <div class="row">
        
        <div class="col-md-3">
            <div class="form-group">
                <label for="DtDiscussDate">Discuss Date</label>
                    <input type="text" class="form-control" id="DtDiscussDate" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="DtDiscussDate">Effective Date</label>
                    <input type="text" class="form-control" id="EffectiveDate" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="DtAcceptanceDate">Acceptance Date</label>
                    <input type="text" class="form-control" id="DtAcceptanceDate" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="DtJoiningDate">Joining Date</label>
                    <input type="text" class="form-control" id="DtJoiningDate" />
            </div>
        </div>
        
    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label for="NumHandSalary">In Hand Salary</label>
                <input type="number" class="form-control" id="NumHandSalary" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="NumOtherAmount">Other Amount</label>
                    <input type="number" class="form-control" id="OtherAmountID" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="btn-mt">
                <button id="" type="button" class="btn btn-draft"><i class="fa fa-step-backward"></i>Previous</button>
                <button id="" type="button" class="btn btn-success"><i class="fa fa-step-forward"></i>Next</button>
            </div>
        </div>
        <div class="offset-md-2 col-md-4">
            <div class="button-right btn-mt">
                <button id="btn-print" type="button" class="btn btn-print"><i class="fa fa-print"></i>Print</button>
                <button id="btn-Next" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
            </div>
        </div>
    </div>
    </fieldset>
</div>

<script>
    $(document).ready(function () {
        $("#btn-Next").hide();
        const storedParams = JSON.parse(sessionStorage.getItem('globalParams') || '{}');
        if (storedParams.readOnly) {
            $('input, textarea, select, button').prop('disabled', true);
        }
        // ddlEmployeeName(function () {
            ddlFinalDepartment(function () {
                ddlFinalDesignation(function () {
                    ddlReportingTo(function () {

                        if (storedParams.docCode) {
                            Getdropdownbanging(storedParams.docCode);
                            hrmsletterintent(storedParams.docCode);
                            Checkhrmstab(storedParams.docCode);
                        }

                    });
                });
            });
        //});

        // ================= SET TODAY DATE =================

        setToday('#DtDocumentDate');
        setToday('#DtDiscussDate');
        setToday('#EffectiveDate');
        setToday('#DtAcceptanceDate');
        setToday('#DtJoiningDate');

        function setToday(id) {
            let d = new Date();
            let day = String(d.getDate()).padStart(2, '0');
            let month = String(d.getMonth() + 1).padStart(2, '0');
            let year = d.getFullYear();
            $(id).val(day + '/' + month + '/' + year);
        }

        // ================= SAVE BUTTON =================

        $('#btn-Next').click(function () {
            var obj = {
                Code: parseInt(storedParams.docCode) || 0,

                V_DATE: $('#DtDocumentDate').val(),

                EmployeeCode: $('#ddlEmployeeName').val() || "",

                DepartmentCode: parseInt($('#ddlDepartment').val()) || 0,
                DesignationCode: parseInt($('#ddlDesignation').val()) || 0,
                ReportingManager: parseInt($('#ddlReportingTo').val()) || 0,

                ReportLocation: $('#TxtReportLocation').val(),

                DiscussionDate: $('#DtDiscussDate').val(),
                EffectiveDate: $('#EffectiveDate').val(),
                AcceptanceDate: $('#DtAcceptanceDate').val(),
                JoiningDate: $('#DtJoiningDate').val(),

                TakeHomeSalary: parseFloat($('#NumHandSalary').val()) || 0,
                GrossSalary: parseFloat($('#OtherAmountID').val()) || 0
            };

            console.log("Sending Data:", obj);

            $.ajax({
                url: '/hrmsletterintent/SaveIntent',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(obj),
                success: function (res) {
                    if (res.status) {
                        alert('Intent Letter Saved Successfully ✅');
                    } else {
                        alert(res.message);
                    }
                },
                error: function (xhr) {
                    console.error("Error:", xhr.responseText);
                    alert('Something went wrong ❌');
                }
            });
        });

    }); // ✅ READY CLOSED



    // ================= DROPDOWN FUNCTIONS =================

    // function ddlEmployeeName(callback) {
    //     $.getJSON('/hrmsletterintent/GetEmployeeName', function (data) {
    //         const ddl = $('#ddlEmployeeName');
    //         ddl.empty().append('<option value="">-- Employee Name --</option>');
    //         $.each(data, function (i, x) {
