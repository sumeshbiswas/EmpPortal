    function ddlFinalDepartment(callback) {
        $.getJSON('/hrmsletterintent/GetddlFinalDepartment', function (data) {
            const ddl = $('#ddlDepartment');
            ddl.empty().append('<option value="">-- Select Department --</option>');
            $.each(data, function (i, x) {
                ddl.append(`<option value="${x.value}">${x.text}</option>`);
            });
            if (callback) callback();
        });
    }

    function ddlFinalDesignation(callback) {
        $.getJSON('/hrmsletterintent/GetddlFinalDesignation', function (data) {
            const ddl = $('#ddlDesignation');
            ddl.empty().append('<option value="">-- Select Designation --</option>');
            $.each(data, function (i, x) {
                ddl.append(`<option value="${x.value}">${x.text}</option>`);
            });
            if (callback) callback();
        });
    }

    function ddlReportingTo(callback) {
        $.getJSON('/hrmsletterintent/GetddlReportingTo', function (data) {
            const ddl = $('#ddlReportingTo');
            ddl.empty().append('<option value="">-- Select Report --</option>');
            $.each(data, function (i, x) {
                ddl.append(`<option value="${x.value}">${x.text}</option>`);
            });
            if (callback) callback();
        });
    }


    // ================= LOAD DROPDOWN VALUES =================

    function Getdropdownbanging(code) {

        $.ajax({
            url: '/hrmsletterintent/Getdropdownbanging',
            type: 'GET',
            data: { code: code },
            success: function (res) {

                if (res && res.length > 0) {

                    var item = res[0];

                    // $('#ddlEmployeeName').val(item.finalLevelName).trigger('change');
                    $('#ddlDepartment').val(item.finalDepartment).trigger('change');
                    $('#ddlDesignation').val(item.finalDesignation).trigger('change');
                }
            },
            error: function () {
                alert('Dropdown loading failed ❌');
            }
        });
    }


    // ================= CHECK TAB STATUS =================

    function Checkhrmstab(code) {
        $.ajax({
            url: '/hrmsletterintent/Checkhrmstable',
            type: 'GET',
            data: { code: code },
            success: function (data) {

                console.log("khushahal singh", data);

                let isBasicComplete = data.firstname && data.firstname.trim() !== "";
                let isInterviewComplete = parseInt(data.checkInterviewData) === 1;

                if (isBasicComplete) {
                    $('#ddlEmployeeName').val(data.firstname);
                }

                // ✅ Final Button Logic with Toastr
                if (isBasicComplete && isInterviewComplete) {

                    $("#btn-Next").show();

                } else {

                    $("#btn-Next").hide();

                    if (!isBasicComplete) {
                        toastr.warning("Please complete Basic Details first.");
                    }
                    else if (!isInterviewComplete) {
                        toastr.warning("Please complete Interview process first.");
                    }
                }

                // Step Completed UI
                if (data.basic == 1)
                    $('[data-step-index="1"]').addClass("completed");

                if (data.personal == 1)
                    $('[data-step-index="2"]').addClass("completed");

                if (data.family == 1)
                    $('[data-step-index="3"]').addClass("completed");

                if (data.education == 1)
                    $('[data-step-index="4"]').addClass("completed");

                if (data.work == 1)
                    $('[data-step-index="5"]').addClass("completed");

                if (data.reference == 1)
                    $('[data-step-index="6"]').addClass("completed");

                if (data.interview == 1)
                    $('[data-step-index="7"]').addClass("completed");

                if (data.letterintent == 1)
                    $('[data-step-index="8"]').addClass("completed");

            },
            error: function (xhr) {
                toastr.error("Something went wrong!");
                console.error("Error:", xhr.responseText);
            }
        });
    }




