        $('#btn-Next').on('click', function (e) {
        e.preventDefault();

        const storedParams = JSON.parse(sessionStorage.getItem('globalParams') || '{}');
        const code = storedParams.docCode || 0;
        const action = code && parseInt(code) > 0 ? "Update" : "Insert";

        if ($('#tblwork tbody tr').length === 0) {
            toastr.warning('Please add at least one work experience record.');
            return;
        }

        function convertToISO(dateStr) {
            if (!dateStr) return null;
            const parts = dateStr.split('/');
            return `${parts[2]}-${parts[1]}-${parts[0]}`; // yyyy-MM-dd
        }

        const dataList = [];

        $('#tblwork tbody tr').each(function () {
            const $cells = $(this).find('td');

            dataList.push({
                Code: $cells.eq(0).text().trim() || null,
                Organization: $cells.eq(1).find('input').val()?.trim() || null,
                Location: $cells.eq(2).find('input').val()?.trim() || null,
                Designation: $cells.eq(3).find('input').val()?.trim() || null,
                Department: $cells.eq(4).find('input').val()?.trim() || null,
                CTC: parseFloat($cells.eq(5).find('input').val()) || 0,
                DurationFrom: convertToISO($cells.eq(6).find('input').val()),
                DurationTo: convertToISO($cells.eq(7).find('input').val()),
                Reason: $cells.eq(8).find('input').val()?.trim() || null
            });
        });

        const payload = {
            Code: parseInt(code) || 0,
            Action: action,
            WorkList: dataList
        };

        console.log("Sending Payload:", payload);

        $.ajax({
            url: '/hrmswork/SaveWorkExperience',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.success) {
                    toastr.success(response.message || 'Data saved successfully!');
                } else {
                    toastr.error(response.message);
                }
            },
            error: function (xhr) {
                toastr.error("Error: " + xhr.responseText);
            }
        });
    });



    function validateRequiredField($field, fieldName) {
        if ($field.length === 0) return true; // element not found, skip validation

        const val = $field.val()?.trim();
        if (!val || val === '-- Select --') {
            toastr.warning(`${fieldName} is required.`);
            $field.focus();
            return false;
        }
        return true;
    }
        function WorkDetail(code) {
            $.ajax({
                url: '/hrmswork/GetworkDetailList',
                type: 'GET',
                data: { code: parseInt(code) },
                success: function (item) {
                    console.log('Work Details:', item);
                    $tbody.empty();

                    if (item && item.workDetails && item.workDetails.length > 0) {
                        item.workDetails.forEach(detail => {
                            addRow(detail);
                        });
                    } else {
                        addRow(); // No data → add blank row
                    }
                },
                error: function (err) {
                    console.error("Failed to load work details:", err);
                }
            });
        }

        function Checkhrmstab(code) {
        $.ajax({
            url: '/hrmshome/Checkhrmstable',
            type: 'GET',
            data: { code: code },
            success: function (data) {

                console.log("Tab Status:", data);

                // Home
                if (data.basic == 1) {
                    $('[data-step-index="1"]').addClass("completed");
                    $("#btn-Next").show();
                }

                // Personal
                if (data.personal == 1) {
                    $('[data-step-index="2"]').addClass("completed");
                }

                // Family
                if (data.family == 1) {
                    $('[data-step-index="3"]').addClass("completed");
                }

                // Education
                if (data.education == 1) {
                    $('[data-step-index="4"]').addClass("completed");
                }

                // Work
                if (data.work == 1) {
                    $('[data-step-index="5"]').addClass("completed");
                }

                // Reference
                if (data.reference == 1) {
                    $('[data-step-index="6"]').addClass("completed");
                }

                // Interview
                if (data.interview == 1) {
                    $('[data-step-index="7"]').addClass("completed");
                }

                 if (data.letterintent == 1)
                   {
                   $('[data-step-index="8"]').addClass("completed");
                   }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
            }
        });
    }

        // Initial readOnly setup
        applyReadOnlyMode();
    });
