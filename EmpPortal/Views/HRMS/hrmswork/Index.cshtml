        function addRow(data = {}) {
            $tbody.find('.btn-add-action').remove(); // Remove existing plus buttons

            const row = `
                <tr>
                    <td style="display:none;">${data.code || ''}</td>
                    <td><input type="text" class="form-control" value="${data.organization || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.location || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.designation || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.department || ''}" /></td>
                    <td><input type="number" class="form-control" value="${data.annuaL_CTC || data.ctc || ''}" /></td>                
                    <td><input type="text" class="form-control datepicker" value="${data.durationFrom || getCurrentDateDMY()}" /> </td>
                    
                    <td> <input type="text" class="form-control datepicker" value="${data.durationTo || getCurrentDateDMY()}" /> </td>

                    <td><input type="text" class="form-control" value="${data.reasoN_FORLEAVING || data.reason || ''}" /></td>
                    <td>
                        <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                        <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                    </td>
                </tr>
            `;
            $tbody.append(row);
            applyReadOnlyMode(); // Re-apply readOnly after DOM update
        }

        function applyReadOnlyMode() {
            if (storedParams.readOnly) {
                $('input, textarea, select, button').prop('disabled', true);
                $('#editButton, #deleteButton').hide();
                $('.btn-add-action, .btn-delete-action').hide();
            }
        }
            function getCurrentDateDMY() {
        const today = new Date();
        const dd = String(today.getDate()).padStart(2, '0');
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const yyyy = today.getFullYear();
        return `${dd}/${mm}/${yyyy}`;
    }


        // Add initial row
        addRow();

        // Add row on + icon or external button
        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            addRow();
        });

        // Delete row
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            const isLast = $row.is(':last-child');
            $row.remove();

            if (isLast) {
                const $last = $tbody.find('tr:last');
                if ($last.length && !$last.find('.btn-add-action').length) {
                    $last.find('td:last').prepend(
                        `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                    );
                }
            }
        });

