        $('#btn-Next').on('click', function (e) {
        e.preventDefault();

        const storedParams = JSON.parse(sessionStorage.getItem('globalParams') || '{}');
        const code = storedParams.docCode || 0;
        const action = code && parseInt(code) > 0 ? "Update" : "Insert";

        // Check if at least one row exists
        if ($('#tblReference tbody tr').length === 0) {
            toastr.warning('Please add at least one reference record.');
            return;
        }

        // Validate required fields in each row
        let isValid = true;
        $('#tblReference tbody tr').each(function (index) {
            const $cells = $(this).find('td');

            if (!validateRequiredField($cells.eq(1).find('input'), `Name in row ${index + 1}`)) {
                isValid = false;
                return false; // break loop on failure
            }
            if (!validateRequiredField($cells.eq(4).find('input'), `Organization in row ${index + 1}`)) {
                isValid = false;
                return false;
            }
            if (!validateRequiredField($cells.eq(5).find('input'), `Designation in row ${index + 1}`)) {
                isValid = false;
                return false;
            }
            if (!validateRequiredField($cells.eq(6).find('input'), `Contact No in row ${index + 1}`)) {
                isValid = false;
                return false;
            }
            if (!validateRequiredField($cells.eq(7).find('input'), `Email in row ${index + 1}`)) {
                isValid = false;
                return false;
            }

            // Email format validation
            const emailVal = $cells.eq(7).find('input').val()?.trim();
            if (emailVal && !validateEmail(emailVal)) {
                toastr.warning(`Invalid email format in row ${index + 1}`);
                $cells.eq(7).find('input').focus();
                isValid = false;
                return false;
            }
        });
        if (!isValid) return;

        const referenceList = [];
        $('#tblReference tbody tr').each(function () {
            const $cells = $(this).find('td');
            referenceList.push({
                Code: $cells.eq(0).text().trim() || null,  // Use text or input value if editable
                Name: $cells.eq(1).find('input').val()?.trim() || null,
                Address: $cells.eq(2).find('input').val()?.trim() || null,
                NatureOfWork: $cells.eq(3).find('input').val()?.trim() || null,
                Organization: $cells.eq(4).find('input').val()?.trim() || null,
                Designation: $cells.eq(5).find('input').val()?.trim() || null,
                ContactNo: $cells.eq(6).find('input').val()?.trim() || null,
                Email: $cells.eq(7).find('input').val()?.trim() || null,
            });
        });

        const payload = {
            Code: parseInt(code) || 0,
            Action: action,
            ReferenceList: referenceList
        };

        $.ajax({
            url: '/hrmsreference/SaveData',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.success) {
                    toastr.success('References saved successfully!');
                } else {
                    toastr.error('Error: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error saving references: ' + error);
            }
        });
    });


        function validateRequiredField($field, fieldName) {
        if ($field.length === 0) return true; // element not found, skip validation

        const val = $field.val()?.trim();
        if (!val || val === '-- Select --') {
            toastr.warning(`${fieldName} is required.`);
            $field.focus();
            return false;
        }
        return true;
    }



            function Checkhrmstab(code) {

        $.ajax({
            url: '/hrmshome/Checkhrmstable',
            type: 'GET',
            data: { code: code },
            success: function (data) {

                console.log("Tab Status:", data);

                // Home
                if (data.basic == 1) {
                    $('[data-step-index="1"]').addClass("completed");
                    $("#btn-Next").show();
                }

                // Personal
                if (data.personal == 1) {
                    $('[data-step-index="2"]').addClass("completed");
                }

                // Family
                if (data.family == 1) {
                    $('[data-step-index="3"]').addClass("completed");
                }

                // Education
                if (data.education == 1) {
                    $('[data-step-index="4"]').addClass("completed");
                }

                // Work
                if (data.work == 1) {
                    $('[data-step-index="5"]').addClass("completed");
                }

                // Reference
                if (data.reference == 1) {
                    $('[data-step-index="6"]').addClass("completed");
                }

                // Interview
                if (data.interview == 1) {
                    $('[data-step-index="7"]').addClass("completed");
                }

                 if (data.letterintent == 1)
                   {
                   $('[data-step-index="8"]').addClass("completed");
                   }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
            }
        });
    }


       function ReferenceDetail(code) {
        $.ajax({
            url: '/hrmsreference/GetReferenceDetailList',
            type: 'GET',
            data: { code: parseInt(code) },
            success: function (item) {
                console.log('Full response:', item);

                if (item && item.referenceDetail && item.referenceDetail.length > 0) {
                    const referenceList = item.referenceDetail;

                    // Clear existing rows
                    $('#tblreference tbody').empty();

                    // Loop and add rows
                    referenceList.forEach(function (ref) {
                        addRow({
                            name: ref.reF_NAME,
                            address: ref.reF_ADDRESS,
                            natureOfWork: ref.reF_WORK,
                            organization: ref.reF_ORGANIZATION,
                            designation: ref.reF_DESIGNATION,
                            contactNo: ref.reF_CONTACTNO,
                            email: ref.reF_EMAIL
                        });
                    });
                } else {
                    console.warn("No reference detail data found.");
                }
            },
            error: function (err) {
                console.error("Failed to load reference details:", err);
            }
        });
    }


    });
</script>



