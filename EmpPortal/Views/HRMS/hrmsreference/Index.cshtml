@{
    ViewBag.Title = "HRMS Home";
    Layout = "~/Views/Shared/EmployeeLayout.cshtml";
}
@await Html.PartialAsync("Partial_Wizard")
<div class="form-section" id="formreference">
    <p class="EmpLabel"><span>Reference Detail</span></p>
    <div class="card">
        <div class="table-responsive">
            <table id="tblreference" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Nature Of Work</th>
                        <th>Organization</th>
                        <th>Designation</th>
                        <th>Contact No.</th>
                        <th>Email Id</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Add Row Button -->
        <div class="row">
            <div class="col-md-12">
                <div class="btn-add-row-last">
                    <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="btn-mt">
                <button id="" type="button" class="btn btn-draft"><i class="fa fa-step-backward"></i>Previous</button>
                <button id="" type="button" class="btn btn-success"><i class="fa fa-step-forward"></i>Next</button>
            </div>
        </div>
        <div class="offset-md-2 col-md-4">
            <div class="button-right btn-mt">
                @*  <a asp-controller="hrmswork" asp-action="Index" class="prev-btn">⬅️ Previous</a>
                <a asp-controller="hrmsinterview" asp-action="Index" class="next-btn">Next ➡️</a> *@
                @* <button id="btn-Previous" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>⬅️ Previous</button> *@
                <button id="btn-Next" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
      $("#btn-Next").hide();
      const storedParams = JSON.parse(sessionStorage.getItem('globalParams') || '{}');
      console.log(storedParams)

        if (storedParams.readOnly) {
          $('input, textarea, select, button').prop('disabled', true);
          $('#editButton, #deleteButton').hide();
      }

      if (storedParams.docCode) {
           ReferenceDetail(storedParams.docCode)
          // checkTab(storedParams.docCode);
          Checkhrmstab(storedParams.docCode);
      }
        const $tbody = $('#tblreference tbody'); // ✅ Reference table

        function addRow(data = {}) {
            // Remove plus icon from previous rows
            $tbody.find('.btn-add-action').remove();

            const row = `
                <tr class="no-border-input">
                    <td style="display:none;">${data.code || ''}</td>
                    <td><input type="text" class="form-control" value="${data.name || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.address || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.natureOfWork || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.organization || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.designation || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.contactNo || ''}" /></td>
                    <td><input type="email" class="form-control" value="${data.email || ''}" /></td>
                    <td>
                        <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                        <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                    </td>
                </tr>
            `;
            $tbody.append(row);
        }

        // Initial row
        addRow();

        // Add row when clicking plus icon or "Add New Row"
        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            addRow();
        });

        // Delete row
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            const isLastRow = $row.is(':last-child');
            $row.remove();

            // If last row deleted, re-add plus on new last row
            if (isLastRow) {
                const $lastRow = $tbody.find('tr:last');
                if ($lastRow.length > 0 && $lastRow.find('.btn-add-action').length === 0) {
                    $lastRow.find('td:last').prepend(
                        `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                    );
                }
            }
        });

