@{
    ViewBag.Title = "HRMS Home";
    Layout = "~/Views/Shared/EmployeeLayout.cshtml";
}
@await Html.PartialAsync("Partial_Wizard")
<div class="form-section" id="formeducation">
    <p class="EmpLabel"><span>Education Detail</span></p>
    <div class="card">
        <div class="table-responsive">
            <table id="tblEducation" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Education</th>
                        <th>Stream</th>
                        <th>Board/University</th>
                        <th>Year</th>
                        <th>Result</th>
                        <th>Percentage</th>
                        <th>Division</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <!-- Pagination container -->
        <div class="row">
            <div class="col-md-12">
                <div class="btn-add-row-last">
                    <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="btn-mt">
                <button id="" type="button" class="btn btn-draft"><i class="fa fa-step-backward"></i>Previous</button>
                <button id="" type="button" class="btn btn-success"><i class="fa fa-step-forward"></i>Next</button>
            </div>
        </div>
        <div class="offset-md-2 col-md-4">
            <div class="button-right btn-mt">
                <button id="btn-Next" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
            </div>
        </div>
    </div>
</div>
<script>
  $(document).ready(function () {
        const $tbody = $('#tblEducation tbody');
        $("#btn-Next").hide();
        function addRow(data = {}) {
            // Remove plus icon from previous rows
            $tbody.find('.btn-add-action').remove();

            const row = `
                <tr class="no-border-input">
                    <td style="display:none;">${data.code || ''}</td>
                    <td><input type="text" class="form-control" value="${data.education || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.stream || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.board || ''}" /></td>
                    <td><input type="number" class="form-control" value="${data.year || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.result || ''}" /></td>
                    <td><input type="number" class="form-control" value="${data.percentage || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.division || ''}" /></td>
                    <td>
                        <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                        <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                    </td>
                </tr>
            `;
            $tbody.append(row);
        }

        // Initially add one empty row
        addRow();

        // Add row when clicking plus icon or "Add New Row"
        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            addRow();
        });

        // Delete row handler
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            const isLastRow = $row.is(':last-child');
            $row.remove();

            // If last row deleted, add plus icon on new last row
            if (isLastRow) {
                const $lastRow = $tbody.find('tr:last');
                if ($lastRow.length > 0 && $lastRow.find('.btn-add-action').length === 0) {
                    $lastRow.find('td:last').prepend(
                        `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                    );
                }
            }
        });

        // Reusable validation function
    function validateRequiredField(selectorOrJQuery, fieldName) {
        const $field = (typeof selectorOrJQuery === 'string') ? $(selectorOrJQuery) : selectorOrJQuery;

        if ($field.length === 0) return true; // skip if element not found

        const value = $field.val()?.trim();
        if (!value || value === '-- Select --') {
            alert(`${fieldName} is required.`);
            $field.focus();
            return false;
        }
        return true;
    }

    $('#btn-Next').on('click', function (e) {
        e.preventDefault();

        // OPTIONAL: Validate static inputs if exist
        if (!validateRequiredField('#education', 'Education')) return;
        if (!validateRequiredField('#board', 'Board/University')) return;
        if (!validateRequiredField('#year', 'Year')) return;

        // Check at least one row
        if ($('#tblEducation tbody tr').length === 0) {
            alert('Please add at least one education record.');
            return;
        }

        // Validate required fields in each row
        let isValid = true;
        $('#tblEducation tbody tr').each(function (index) {
            const $cells = $(this).find('td');

            if (!validateRequiredField($cells.eq(1).find('input'), `Education in row ${index + 1}`)) {
                isValid = false;
                return false;
            }
            if (!validateRequiredField($cells.eq(3).find('input'), `Board/University in row ${index + 1}`)) {
                isValid = false;
                return false;
            }
            if (!validateRequiredField($cells.eq(4).find('input'), `Year in row ${index + 1}`)) {
                isValid = false;
                return false;
            }
        });
        if (!isValid) return;

        const storedParams = JSON.parse(sessionStorage.getItem('globalParams') || '{}');
        const code = parseInt(storedParams.docCode || 0);
        const action = code > 0 ? "Update" : "Insert";

        // Helper function to get value or null/0
        function getVal($cell, isNumber = false) {
            const val = $cell.find('input').val()?.trim();
            if (!val) return isNumber ? 0 : null;
            return isNumber ? Number(val) || 0 : val;
        }

        const dataList = [];
        $('#tblEducation tbody tr').each(function () {
            const $cells = $(this).find('td');

            dataList.push({
                code: $cells.eq(0).text().trim() || null,
                education: getVal($cells.eq(1)),
                stream: getVal($cells.eq(2)),
                board: getVal($cells.eq(3)),
                year: getVal($cells.eq(4), true),
                result: getVal($cells.eq(5)),
                percentage: getVal($cells.eq(6), true),
                division: getVal($cells.eq(7))
            });
        });

        const payload = {
            code: code,
            action: action,
            educationList: dataList
        };

        $.ajax({
            url: '/hrmseducation/Savedata',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
               toastr.success('Data saved successfully!');
            },
            error: function (xhr, status, error) {
               toastr.error('Error saving data: ' + error);
            }
        });
    });
        // Your reusable validation function
    function validateRequiredField(selectorOrJQuery, fieldName) {
        const $field = (typeof selectorOrJQuery === 'string') ? $(selectorOrJQuery) : selectorOrJQuery;

        if ($field.length === 0) return true; 

        const value = $field.val()?.trim();
        if (!value || value === '-- Select --') {
                toastr.warning(`${fieldName} is required.`);
            $field.focus();
            return false;
        }
        return true;
    }
        // Function to fetch and show education details from database
        function PersonalDetail(code) {
            $.ajax({
                url: '/hrmseducation/GetEducationDetailList',
                type: 'GET',
                data: { code: parseInt(code) },
                success: function (response) {
                    console.log('Full response:', response);

                    const educationDetails = response.educationDetails || [];
                    $tbody.empty();  // Clear existing rows

                    if (educationDetails.length === 0) {
                        addRow();  // Add empty row if no data
                    } else {
                        educationDetails.forEach(function (item) {
                            addRow({
                                education: item.education || '',
                                stream: item.stream || '',
                                board: item.boarD_UNIVERSITY || '',
                                year: item.year || '',
                                result: item.result || '',
                                percentage: item.percentage || '',
                                division: item.division || ''
                            });
                        });
                    }
                },
                error: function (err) {
                    console.error("Failed to load education details:", err);
                }
            });
        }

       function Checkhrmstab(code) {
         $.ajax({
             url: '/hrmshome/Checkhrmstable',
             type: 'GET',
             data: { code: code },
             success: function (data) {

                 console.log("Tab Status:", data);

                 // Home
                 if (data.basic == 1) {
                     $('[data-step-index="1"]').addClass("completed");
                     $("#btn-Next").show();
                 }

                 // Personal
                 if (data.personal == 1) {
                     $('[data-step-index="2"]').addClass("completed");
                 }

                 // Family
                 if (data.family == 1) {
                     $('[data-step-index="3"]').addClass("completed");
                 }

                 // Education
                 if (data.education == 1) {
                     $('[data-step-index="4"]').addClass("completed");
                 }

                 // Work
                 if (data.work == 1) {
                     $('[data-step-index="5"]').addClass("completed");
                 }

                 // Reference
                 if (data.reference == 1) {
                     $('[data-step-index="6"]').addClass("completed");
                 }

                 // Interview
                 if (data.interview == 1) {
                     $('[data-step-index="7"]').addClass("completed");
                 }
                   if (data.letterintent == 1)
                   {
                   $('[data-step-index="8"]').addClass("completed");
                   }
             },
             error: function (xhr) {
                 console.error("Error:", xhr.responseText);
             }
         });
     }

        // Example: call PersonalDetail with some code to load data on page load
        const storedParams = JSON.parse(sessionStorage.getItem('globalParams') || '{}');
        if (storedParams.docCode) {
            PersonalDetail(storedParams.docCode);
            // checkTab(storedParams.docCode);
            Checkhrmstab(storedParams.docCode)
        }

    });
</script>

